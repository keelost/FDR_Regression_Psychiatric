# ---- Large genomic data files ----
*.gz
*.vcf
*.vcf.gz
*.bgen
*.bgen.bgi
*.sumstats
*.sumstats.gz
*.ldsc
*.bed
*.bim
*.fam
*.bim.gz
*.bed.gz

# ---- PLINK binary files ----
*.nbin
*.log

# ---- R session files ----
.RData
.Rhistory
.Rproj.user/
*.Rproj

# ---- Local server configuration ----
config/project.env

# ---- Data directories (contents only, keep .gitkeep) ----
data/raw/*
!data/raw/.gitkeep
data/reference/*
!data/reference/.gitkeep
data/annotations/*
!data/annotations/.gitkeep
!data/annotations/magma-library-all.csv
!data/annotations/magma-library-uniq-ensembl.csv
!data/annotations/magma-library-uniq-entrez.csv

# ---- Results directory (contents only, keep .gitkeep) ----
results/*
!results/.gitkeep

# ---- Python cache ----
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ---- Jupyter notebook checkpoints ----
.ipynb_checkpoints/

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- Conda environments ----
.conda/
